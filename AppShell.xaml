<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="IntervalTimer.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:IntervalTimer.Views"
    Title="IntervalTimer"
    Shell.FlyoutBehavior="Disabled">

    <TabBar>
        <Tab Title="Dashboard">
            <ShellContent ContentTemplate="{DataTemplate views:DashboardPage}" />
        </Tab>
        <Tab Title="Presets">
            <ShellContent ContentTemplate="{DataTemplate views:PresetsPage}" />
        </Tab>
        <Tab Title="History">
            <ShellContent ContentTemplate="{DataTemplate views:HistoryPage}" />
        </Tab>
    </TabBar>
</Shell>
