<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:IntervalTimer.ViewModels"
             x:Class="IntervalTimer.Views.PresetDetailPage"
             Title="Edit Preset"
             BackgroundColor="{StaticResource OffBlack}">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">
            
            <Label Text="Preset Name" TextColor="{StaticResource Gray400}" FontSize="14" />
            <Entry Text="{Binding Name}" Placeholder="e.g. 5k Training" TextColor="White" BackgroundColor="{StaticResource Surface}" />

            <!-- Run Time -->
            <Label Text="Run Duration" TextColor="{StaticResource RunColor}" FontSize="16" FontAttributes="Bold" Margin="0,10,0,0" />
            <Grid ColumnDefinitions="*, *" ColumnSpacing="10">
                <VerticalStackLayout Grid.Column="0">
                    <Label Text="Minutes" TextColor="{StaticResource Gray500}" FontSize="12" />
                    <Entry Text="{Binding RunMinutes}" Keyboard="Numeric" TextColor="White" BackgroundColor="{StaticResource Surface}" />
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="1">
                    <Label Text="Seconds" TextColor="{StaticResource Gray500}" FontSize="12" />
                    <Entry Text="{Binding RunSeconds}" Keyboard="Numeric" TextColor="White" BackgroundColor="{StaticResource Surface}" />
                </VerticalStackLayout>
            </Grid>

            <!-- Walk Time -->
            <Label Text="Walk Duration" TextColor="{StaticResource WalkColor}" FontSize="16" FontAttributes="Bold" Margin="0,10,0,0" />
            <Grid ColumnDefinitions="*, *" ColumnSpacing="10">
                <VerticalStackLayout Grid.Column="0">
                    <Label Text="Minutes" TextColor="{StaticResource Gray500}" FontSize="12" />
                    <Entry Text="{Binding WalkMinutes}" Keyboard="Numeric" TextColor="White" BackgroundColor="{StaticResource Surface}" />
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="1">
                    <Label Text="Seconds" TextColor="{StaticResource Gray500}" FontSize="12" />
                    <Entry Text="{Binding WalkSeconds}" Keyboard="Numeric" TextColor="White" BackgroundColor="{StaticResource Surface}" />
                </VerticalStackLayout>
            </Grid>

            <HorizontalStackLayout Spacing="10" Margin="0,10,0,0">
                <Switch IsToggled="{Binding StartWithRun}" OnColor="{StaticResource RunColor}" />
                <Label Text="Start with Run" TextColor="White" VerticalOptions="Center" />
            </HorizontalStackLayout>

            <!-- Optional Limits -->
            <Label Text="Optional Limits (0 = Infinite)" TextColor="{StaticResource Gray400}" FontSize="14" Margin="0,10,0,0" />
            <Grid ColumnDefinitions="*, *" ColumnSpacing="10">
                <VerticalStackLayout Grid.Column="0">
                    <Label Text="Total Mins" TextColor="{StaticResource Gray500}" FontSize="12" />
                    <Entry Text="{Binding TotalDurationMinutes}" Keyboard="Numeric" TextColor="White" BackgroundColor="{StaticResource Surface}" />
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="1">
                    <Label Text="Total Intervals" TextColor="{StaticResource Gray500}" FontSize="12" />
                    <Entry Text="{Binding TotalIntervals}" Keyboard="Numeric" TextColor="White" BackgroundColor="{StaticResource Surface}" />
                </VerticalStackLayout>
            </Grid>

            <Button Text="SAVE PRESET" Command="{Binding SaveCommand}" 
                    BackgroundColor="{StaticResource Primary}" TextColor="{StaticResource PrimaryDarkText}"
                    HeightRequest="50" CornerRadius="25" FontAttributes="Bold" Margin="0,20,0,0" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
