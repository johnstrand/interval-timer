<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:IntervalTimer.Models"
             xmlns:viewmodels="clr-namespace:IntervalTimer.ViewModels"
             x:Class="IntervalTimer.Views.PresetsPage"
             Title="Presets"
             BackgroundColor="{StaticResource OffBlack}">

    <Grid RowDefinitions="*, Auto" Padding="20">
        
        <CollectionView Grid.Row="0" ItemsSource="{Binding Presets}">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Preset">
                    <Border Stroke="{StaticResource Surface}" StrokeThickness="1" BackgroundColor="{StaticResource Surface}" Margin="0,0,0,10" Padding="15">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10" />
                        </Border.StrokeShape>
                        <Grid ColumnDefinitions="*, Auto" RowDefinitions="Auto, Auto">
                            <Label Grid.Column="0" Grid.Row="0" Text="{Binding Name}" FontSize="18" FontAttributes="Bold" TextColor="White" />
                            <Label Grid.Column="0" Grid.Row="1" TextColor="{StaticResource Gray400}" FontSize="14">
                                <Label.Text>
                                    <MultiBinding StringFormat="Run: {0}s | Walk: {1}s">
                                        <Binding Path="RunTime" />
                                        <Binding Path="WalkTime" />
                                    </MultiBinding>
                                </Label.Text>
                            </Label>
                            
                            <HorizontalStackLayout Grid.Column="1" Grid.RowSpan="2" Spacing="10" VerticalOptions="Center">
                                <Button Text="Edit" Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:PresetsViewModel}}, Path=EditPresetCommand}" CommandParameter="{Binding .}" BackgroundColor="Transparent" TextColor="{StaticResource Secondary}" FontSize="14" />
                                <Button Text="Del" Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:PresetsViewModel}}, Path=DeletePresetCommand}" CommandParameter="{Binding .}" BackgroundColor="Transparent" TextColor="{StaticResource Magenta}" FontSize="14" />
                            </HorizontalStackLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Button Grid.Row="1" Text="+ CREATE PRESET" Command="{Binding AddNewPresetCommand}"
                BackgroundColor="{StaticResource Primary}" TextColor="{StaticResource PrimaryDarkText}"
                HeightRequest="60" CornerRadius="30" FontAttributes="Bold" FontSize="16" Margin="0,20,0,0"/>
    </Grid>

</ContentPage>
